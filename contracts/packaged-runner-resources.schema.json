{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaomustudio.local/contracts/packaged-runner-resources.schema.json",
  "title": "Packaged Python Runner source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "runner_version", "requires_python", "files"],
  "properties": {
    "kind": { "const": "yaomu_runner_resources" },
    "schema_version": { "const": 1 },
    "runner_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"
    },
    "requires_python": { "const": ">=3.11" },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/file" },
      "allOf": [
        { "contains": { "$ref": "#/$defs/initFile" } },
        { "contains": { "$ref": "#/$defs/entryFile" } },
        { "contains": { "$ref": "#/$defs/mainFile" } }
      ]
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^yaomustudio_runner/(?:[A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*$",
          "not": {
            "anyOf": [
              { "pattern": "(?:^|/)__[pP][yY][cC][aA][cC][hH][eE]__(?:/|$)" },
              { "pattern": "\\.[pP][yY][cCoO]$" }
            ]
          }
        },
        "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "initFile": {
      "type": "object",
      "required": ["path"],
      "properties": { "path": { "const": "yaomustudio_runner/__init__.py" } }
    },
    "entryFile": {
      "type": "object",
      "required": ["path"],
      "properties": { "path": { "const": "yaomustudio_runner/__main__.py" } }
    },
    "mainFile": {
      "type": "object",
      "required": ["path"],
      "properties": { "path": { "const": "yaomustudio_runner/main.py" } }
    }
  },
  "description": "Local assembly integrity only, not a signature. Consumer also checks ordinal sorting, case-folded path uniqueness, exact file-tree correspondence, sizes/hashes, no links/special files/escape, and bounded reads. Installation-root Unicode/spaces are not restricted by the internal source-path pattern."
}
